# =============================================================================
# CHRONOS PORTAL - ENVIRONMENT TEMPLATE
# Copy this file to .env and fill in your actual credentials.
# =============================================================================

# NeonDB Serverless PostgreSQL Credentials
SPRING_DATASOURCE_URL=jdbc:postgresql://<neon-host>/<database>?sslmode=require
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=your_neon_password_here

# Base64 HMAC-SHA256 Token Secret (Generate using: openssl rand -base64 32)
JWT_SECRET=your_base64_encoded_32byte_secret_key_here

# Administrator Login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Server Port
PORT=8080
